---
pagename: localizacao
layout: layouts/base.liquid
title: Localização | Clínica Odontológica
stylesheet: /css/page/localizacao.css
---

<section class="section page-hero location-hero">
	<div class="section-container">
		<div class="section-content">
			<div class="column">
				<div>
					<h1>Seu dentista no Belvedere</h1>
					<p class="subheading">Fácil acesso, próximo ao BH shopping</p>
				</div>
			</div>
		</div>
	</div>
</section>

<section class="section location-section" id="mapa">
	<div class="section-container">
		<div class="section-content">
			<div class="column">
				<span class="kicker">Visite-nos</span><h2>Chegar até nós é simples</h2>
				<p class="location-label">Endereço</p><p>{{ clinic.location.address }}</p>
				<p class="location-label">Horários</p><p>{{ clinic.location.hours }}</p>
				<div class="map-embed">
					<iframe title="Localização da clínica no mapa" src="{{ clinic.location.mapEmbed }}" width="100%" height="350" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
				</div>
				<a href="{{ clinic.location.mapsUrl | url }}" target="_blank" rel="noopener noreferrer" class="btn">Como chegar</a>
			</div>
		</div>
	</div>
</section>
