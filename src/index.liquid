---
pagename: home
layout: layouts/base.liquid
title: Clínica Odontológica | Cuidado completo para seu sorriso
stylesheet: /css/page/home.css
---

<section class="section hero-section home-hero" id="hero">
	<div class="section-container">
		<div class="section-content">
			<div class="column">
				<div class="hero-text hero-copy">
					<span class="kicker">Odontologia em Belo Horizonte</span>
					<h1>Seu sorriso merece o melhor cuidado</h1>
					<p class="subheading">Atendimento odontológico completo, com tecnologia moderna e uma equipe pronta para cuidar de você em cada etapa do tratamento.</p>
				</div>
				{% include "cta/whatsapp-primary.liquid" %}
				<div class="hero-trust"><span><i class="iconoir-shield-check"></i> Atendimento acolhedor</span><span><i class="iconoir-spark"></i> Tecnologia e precisão</span></div>
			</div>
      <div class="column home-hero-image"><img src="{{ '/assets/images/hero_image.png' | url }}" alt="Paciente sorrindo durante atendimento odontológico"></div>
		</div>
	</div>
</section>

<section class="section services-preview">
  <div class="section-container">
    <div class="section-content">
      <div class="column">
        <div class="section-heading"><div><span class="kicker">Tratamentos</span><h2>Cuidado pensado para o seu momento</h2></div><a class="text-link" href="{{ '/servicos/' | url }}">Ver todos os serviços <i class="iconoir-arrow-right"></i></a></div>
        <div class="card-grid services-grid">
          <a href="{{ '/servicos/restauracao/' | url }}" class="center card card-hover img-card-grid">
            <div class="img-card-grid-image"><img src="{{ '/assets/images/pexels-cottonbro-6502745.jpg' | url }}" alt="Restauração (Dor de Dente)"></div>
            <div class="img-card-grid-title">Restauração (Dor de Dente)</div>
          </a>
          <a href="{{ '/servicos/clareamento/' | url }}" class="center card card-hover img-card-grid">
            <div class="img-card-grid-image"><img src="{{ '/assets/images/whitening4.jpg' | url }}" alt="Clareamento"></div>
            <div class="img-card-grid-title">Clareamento</div>
          </a>
          <a href="{{ '/servicos/aparelho/' | url }}" class="center card card-hover img-card-grid">
            <div class="img-card-grid-image"><img src="{{ '/assets/images/braces.jpg' | url }}" alt="Aparelhos (Ortodontia)"></div>
            <div class="img-card-grid-title">Aparelhos (Ortodontia)</div>
          </a>
          <a href="{{ '/servicos/implante/' | url }}" class="center card card-hover img-card-grid">
            <div class="img-card-grid-image"><img src="{{ '/assets/images/implant.jpg' | url }}" alt="Implante"></div>
            <div class="img-card-grid-title">Implante</div>
          </a>
          <a href="{{ '/servicos/protese/' | url }}" class="center card card-hover img-card-grid">
            <div class="img-card-grid-image"><img src="{{ '/assets/images/prosthesis.jpg' | url }}" alt="Prótese"></div>
            <div class="img-card-grid-title">Prótese</div>
          </a>
          <a href="{{ '/servicos/estetica/' | url }}" class="center card card-hover img-card-grid">
            <div class="img-card-grid-image"><img src="{{ '/assets/images/botox.jpg' | url }}" alt="Harmonização Orofacial"></div>
            <div class="img-card-grid-title">Harmonização Orofacial</div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section team-preview" id="equipe">
  <div class="section-container">
    <div class="section-content">
      <div class="column">
        <div class="section-heading"><div><span class="kicker">Nossa equipe</span><h2>Gente que cuida de gente</h2></div><a class="text-link" href="{{ '/equipe/' | url }}">Conheça a equipe <i class="iconoir-arrow-right"></i></a></div>
        <div class="team-list team-grid">
          <article class="team-entry"><a href="{{ '/equipe/dra-cristiana/' | url }}" class="team-card card card-hover img-card-grid"><div class="img-card-grid-image"><img src="{{ '/assets/images/generic_doctor.jpg' | url }}" alt="Dra. Cristiana"></div><div class="team-card-content"><div class="team-card-name">Dra. Cristiana</div><span class="team-card-role">Clínica geral e estética odontológica</span></div></a><div class="team-card-meta"><span>Mais de 10 anos de experiência</span><a href="{{ '/equipe/dra-cristiana/' | url }}" class="text-link">Ver perfil <i class="iconoir-arrow-right"></i></a></div></article>
          <article class="team-entry"><a href="{{ '/equipe/dr-vinicius/' | url }}" class="team-card card card-hover img-card-grid"><div class="img-card-grid-image"><img src="{{ '/assets/images/generic_doctor.jpg' | url }}" alt="Dr. Vinicius"></div><div class="team-card-content"><div class="team-card-name">Dr. Vinicius</div><span class="team-card-role">Implantodontia e reabilitação oral</span></div></a><div class="team-card-meta"><span>Mais de 10 anos de experiência</span><a href="{{ '/equipe/dr-vinicius/' | url }}" class="text-link">Ver perfil <i class="iconoir-arrow-right"></i></a></div></article>
          <article class="team-entry"><a href="{{ '/equipe/dr-cassio/' | url }}" class="team-card card card-hover img-card-grid"><div class="img-card-grid-image"><img src="{{ '/assets/images/generic_doctor.jpg' | url }}" alt="Dr. Cássio"></div><div class="team-card-content"><div class="team-card-name">Dr. Cássio</div><span class="team-card-role">Ortodontia</span></div></a><div class="team-card-meta"><span>Mais de 10 anos de experiência</span><a href="{{ '/equipe/dr-cassio/' | url }}" class="text-link">Ver perfil <i class="iconoir-arrow-right"></i></a></div></article>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section location-preview" id="localizacao">
	<div class="section-container">
		<div class="section-content">
			<div class="column">
				<h2><i class="iconoir-map-pin" aria-hidden="true"></i>Onde estamos</h2>
				<p>Rua Exemplo, 123 — Bairro, Belo Horizonte/MG</p>
				<p>Seg a Sex: 8h às 18h | Sáb: 8h às 12h</p>
				<div class="map-embed">
					<iframe src="https://www.google.com/maps/embed?pb=SEU_EMBED" width="100%" height="350" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
				</div>
				<a href="{{ 'https://maps.google.com/?q=SEU_ENDERECO' | url }}" target="_blank" rel="noopener noreferrer" class="btn">Como chegar</a>
			</div>
		</div>
	</div>
</section>

<section class="section appointment-section" id="agendar">
	<div class="section-container">
		<div class="section-content">
			<div class="column">
				<span class="kicker">Seu próximo passo</span><h2>Agende sua consulta</h2><p class="subheading">Conte o que você precisa. Nós ajudamos a encontrar o melhor caminho.</p>
				{% include "cta/whatsapp-primary.liquid" %}
				{% include "cta/whatsapp-link.liquid" %}
			</div>
		</div>
	</div>
</section>
