---
pagename: home
layout: layouts/base.liquid
title: Clínica Odontológica | Cuidado completo para seu sorriso
stylesheet: /css/page/home.css
---

<section class="section hero-section home-hero" id="hero">
	<div class="section-container">
		<div class="section-content">
			<div class="column">
				<div class="hero-text hero-copy">
					<span class="kicker">Dentista no Belvedere</span>
					<h1>Seu sorriso merece o melhor cuidado</h1>
					<p class="subheading">Atendimento odontológico completo, com tecnologia moderna e uma equipe pronta para cuidar de você em cada etapa do tratamento.</p>
				</div>
				{% include "cta/whatsapp-primary.liquid" %}
			</div>
      <div class="column home-hero-image">{% imageHigh "src/assets/images/teeth_inspection_diagnosis.jpg", "Paciente sorrindo durante atendimento odontológico", "(max-width: 700px) 100vw, 50vw" %}</div>
		</div>
	</div>
</section>

<section class="section services-preview">
  <div class="section-container">
    <div class="section-content">
      <div class="column">
        <div class="section-heading"><div><span class="kicker">Tratamentos</span><h2>Cuidado pensado para o seu momento</h2></div><a class="text-link" href="{{ '/servicos/' | url }}">Ver todos os serviços <i class="iconoir-arrow-right"></i></a></div>
        <div class="card-grid services-grid">
          <a href="{{ '/servicos/restauracao/' | url }}" class="center card card-hover img-card-grid">
            <div class="img-card-grid-image">{% image "src/assets/images/pexels-cottonbro-6502745.jpg", "Restauração dentária", "(max-width: 700px) 50vw, 25vw" %}</div>
            <div class="img-card-grid-title">Restauração dentária</div>
          </a>
          <a href="{{ '/servicos/clareamento/' | url }}" class="center card card-hover img-card-grid">
            <div class="img-card-grid-image">{% image "src/assets/images/whitening4.jpg", "Clareamento dental", "(max-width: 700px) 50vw, 25vw" %}</div>
            <div class="img-card-grid-title">Clareamento</div>
          </a>
          <a href="{{ '/servicos/odontopediatria/' | url }}" class="center card card-hover img-card-grid">
            <div class="img-card-grid-image">{% image "src/assets/images/real_dentist_with_child_patient_odontopediatria.jpeg", "Atendimento odontopediátrico com criança", "(max-width: 700px) 50vw, 25vw" %}</div>
            <div class="img-card-grid-title">Odontopediatria</div>
          </a>
          <a href="{{ '/servicos/aparelho/' | url }}" class="center card card-hover img-card-grid">
            <div class="img-card-grid-image">{% image "src/assets/images/braces.jpg", "Aparelhos (Ortodontia)", "(max-width: 700px) 50vw, 25vw" %}</div>
            <div class="img-card-grid-title">Aparelhos (Ortodontia)</div>
          </a>
          <a href="{{ '/servicos/implante/' | url }}" class="center card card-hover img-card-grid">
            <div class="img-card-grid-image">{% image "src/assets/images/implant.jpg", "Implante dentário", "(max-width: 700px) 50vw, 25vw" %}</div>
            <div class="img-card-grid-title">Implante</div>
          </a>
          <a href="{{ '/servicos/protese/' | url }}" class="center card card-hover img-card-grid">
            <div class="img-card-grid-image">{% image "src/assets/images/prosthesis.jpg", "Prótese dentária", "(max-width: 700px) 50vw, 25vw" %}</div>
            <div class="img-card-grid-title">Prótese</div>
          </a>
          <a href="{{ '/servicos/estetica/' | url }}" class="center card card-hover img-card-grid">
            <div class="img-card-grid-image">{% image "src/assets/images/botox.jpg", "Estética facial e dental", "(max-width: 700px) 50vw, 25vw" %}</div>
            <div class="img-card-grid-title">Estética facial e dental</div>
          </a>
          <a href="{{ '/servicos/outros/' | url }}" class="center card card-hover img-card-grid">
            <div class="img-card-grid-image">{% image "src/assets/images/teeth_blackandwhite_woman.jpg", "Mulher sorrindo", "(max-width: 700px) 50vw, 25vw" %}</div>
            <div class="img-card-grid-title">Outros</div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section team-preview" id="equipe">
  <div class="section-container">
    <div class="section-content">
      <div class="column">
        <div class="section-heading"><div><span class="kicker">Nossa equipe</span><h2>Gente que cuida de gente</h2></div><a class="text-link" href="{{ '/equipe/' | url }}">Conheça a equipe <i class="iconoir-arrow-right"></i></a></div>
        <div class="team-list team-grid">
          {% for profissional in equipe %}
          <article class="team-entry"><a href="{{ profissional.slug | prepend: '/equipe/' | append: '/' | url }}" class="team-card card card-hover img-card-grid"><div class="img-card-grid-image">{% image profissional.image, profissional.alt, "(max-width: 700px) 50vw, 25vw" %}</div><div class="team-card-content"><div class="team-card-name">{{ profissional.name }}</div><span class="team-card-role">{{ profissional.specialization }}</span></div></a><div class="team-card-meta">{% if features.showTeamExperience %}<span>{{ profissional.experience }}</span>{% endif %}<a href="{{ profissional.slug | prepend: '/equipe/' | append: '/' | url }}" class="text-link">Ver perfil <i class="iconoir-arrow-right"></i></a></div></article>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section location-preview" id="localizacao">
	<div class="section-container">
		<div class="section-content">
      <div class="column">
        <div class="map-embed">
          <iframe title="Localização da clínica no mapa" src="{{ clinic.location.mapEmbed }}" width="100%" height="350" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
				</div>
        <a href="{{ clinic.location.mapsUrl | url }}" target="_blank" rel="noopener noreferrer" class="btn">Abrir no Google Maps</a>
      </div>
			<div class="column">
				<h2><i class="iconoir-map-pin" aria-hidden="true"></i>Onde estamos</h2>
        <p>{{ clinic.location.address }}</p>
        <p>{{ clinic.location.hours }}</p>
			</div>
		</div>
	</div>
</section>

<section class="section appointment-section" id="agendar">
	<div class="section-container">
		<div class="section-content">
			<div class="column">
				<span class="kicker">Seu próximo passo</span><h2>Agende sua consulta</h2><p class="subheading">Conte o que você precisa. Nós ajudamos a encontrar o melhor caminho.</p>
				{% include "cta/whatsapp-primary.liquid" %}
			</div>
		</div>
	</div>
</section>
