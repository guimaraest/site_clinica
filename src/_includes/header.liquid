<header class="header" id="siteHeader">
  <div class="header-container">
    <a class="brand" href="{{ '/' | url }}" aria-label="Concept Belvedere — página inicial">
      <span class="brand-mark" aria-hidden="true">CB</span>
      <span class="brand-name">Concept<br>Belvedere</span>
    </a>
    <div class="nav-wrapper">
      <button class="menu-button" id="menuButton" type="button" aria-expanded="false" aria-controls="headerNav" aria-label="Abrir menu">
        <span class="menu-open" aria-hidden="true">
          {% include "icons/hamburger-open.liquid" %}
        </span>
        <span class="menu-close" aria-hidden="true">
          {% include "icons/hamburger-close.liquid" %}
        </span>
      </button>
      <nav id="headerNav" class="nav" aria-hidden="false">
        <ul class="nav-links">
          {% for item in nav.nav %}
            <li class="nav-item">
              <a href="{{ item.url | url }}" class="link">{{ item.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>
    <div class="header-action">
      <a href="{{ '/#agendar' | url }}" class="btn btn-nav">
        <span>{{ nav.button.title }}</span>
      </a>
    </div>
  </div>
  <hamburger-menu></hamburger-menu>
</header>

