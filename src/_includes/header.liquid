<header class="header" id="siteHeader">
  <div class="header-container">
    <div class="nav-wrapper">
      <button class="menu-button" id="menuButton" type="button" aria-expanded="false" aria-controls="headerNav" aria-label="Abrir menu">
        <span class="menu-open" aria-hidden="true">
          {% include "icons/hamburger-open.liquid" %}
        </span>
        <span class="menu-close" aria-hidden="true">
          {% include "icons/hamburger-close.liquid" %}
        </span>
      </button>
      <nav id="headerNav" class="nav" aria-hidden="false">
        <ul class="nav-links">
          {% for item in nav.nav %}{% assign item_id = item.title | slugify %}
            {% if item.children %}
              <li class="nav-item has-dropdown">
                <button type="button" class="dropdown-button button-clear" aria-expanded="false" aria-controls="dropdown-{{ item_id }}">
                  {{ item.title }}
                  {% include "icons/arrow-down.liquid", class: "dropdown-icon" %}
                </button>
                <ul class="dropdown-menu" id="dropdown-{{ item_id }}">
                  {% for child in item.children %}
                    <li><a href="{{ child.url | url }}" class="link">{{ child.title }}</a></li>
                  {% endfor %}
                </ul>
              </li>
            {% else %}
              <li class="nav-item">
                <a href="{{ item.url | url }}" class="link">{{ item.title }}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </nav>
    </div>
    <div>
      <a href="{{ nav.button.url }}" target="_blank" rel="noopener noreferrer" class="btn btn-nav">
        <span>{{ nav.button.title }}</span>
      </a>
    </div>
  </div>
  <hamburger-menu></hamburger-menu>
</header>

