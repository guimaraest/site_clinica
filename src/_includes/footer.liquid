<footer class="footer">
  <div class="section-container footer-container">
    <div class="footer-content">
      <div class="footer-row footer-main">
        <div class="footer-brand">
          <span class="brand-mark" aria-hidden="true">CB</span>
          <p>Concept Belvedere</p>
          <span>Odontologia com cuidado em cada detalhe.</span>
        </div>
        <div class="footer-column footer-contact">
          <span class="footer-label">Fale conosco</span>
          <a href="mailto:{{ footer.contact.email }}" class="link">{{ footer.contact.email }}</a>
          <a href="/#agendar" class="link">Agende uma consulta</a>
        </div>
        <div class="footer-column">
          <span class="footer-label">Acompanhe</span>
          <nav class="footer-social">
            {% for item in footer.social %}<a href="{{ item.url }}" rel="noopener" target="_blank" class="link">{{ item.name }}</a>{% endfor %}
          </nav>
        </div>
      </div>
      <div class="footer-row footer-bottom"><small>© {{ footer.copyright.year }} {{ footer.copyright.holder }}</small><small>Todos os direitos reservados.</small></div>
    </div>
  </div>
</footer>

