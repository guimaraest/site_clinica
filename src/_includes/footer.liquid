<footer class="footer">
  <div class="section-container footer-container">
    <div class="footer-content">
      <div class="footer-row footer-main">
        <div class="footer-brand">
          <span class="brand-mark" aria-hidden="true">CB</span>
          <p>{{ clinic.name }}</p>
          <span>Odontologia com cuidado em cada detalhe.</span>
        </div>
        <div class="footer-column footer-contact">
          <span class="footer-label">Fale conosco</span>
          <a href="{{ clinic.contact.whatsapp | url }}" class="link"><i class="iconoir-whatsapp" aria-hidden="true"></i><span>WhatsApp</span></a><a href="mailto:{{ clinic.contact.email }}" class="link"><i class="iconoir-mail" aria-hidden="true"></i><span>E-mail</span></a>
        </div>
        <div class="footer-column footer-address"><span class="footer-label">Endereço</span><p><i class="iconoir-map-pin" aria-hidden="true"></i>{{ clinic.location.address }}</p></div>
        <div class="footer-column">
          <span class="footer-label">Acompanhe</span>
          <nav class="footer-social">
            <a href="{{ clinic.social.instagram.url | url }}" rel="noopener" target="_blank" class="link" aria-label="Instagram"><i class="iconoir-instagram" aria-hidden="true"></i><span>{{ clinic.social.instagram.handle }}</span></a>
          </nav>
        </div>
      </div>
      <div class="footer-row footer-bottom"><small>© {{ clinic.copyright.year }} {{ clinic.copyright.holder }}</small><small>Todos os direitos reservados.</small></div>
    </div>
  </div>
</footer>

