<footer class="footer">
  <div class="section-container footer-container">
    <div class="footer-content">
      <div class="footer-row footer-main">
        <div class="footer-brand">
          <span class="brand-mark" aria-hidden="true">CB</span>
          <p>Concept Belvedere</p>
          <span>Odontologia com cuidado em cada detalhe.</span>
        </div>
        <div class="footer-column footer-contact">
          <span class="footer-label">Fale conosco</span>
          {% for item in footer.social %}{% if item.name == "WhatsApp" or item.name == "E-mail" %}<a href="{{ item.url | url }}" class="link"><i class="{{ item.icon }}" aria-hidden="true"></i><span>{{ item.name }}</span></a>{% endif %}{% endfor %}
        </div>
        <div class="footer-column footer-address"><span class="footer-label">Endereço</span><p><i class="iconoir-map-pin" aria-hidden="true"></i>{{ footer.contact.address }}</p></div>
        <div class="footer-column">
          <span class="footer-label">Acompanhe</span>
          <nav class="footer-social">
            {% for item in footer.social %}{% if item.name == "Instagram" %}<a href="{{ item.url | url }}" rel="noopener" target="_blank" class="link" aria-label="{{ item.name }}"><i class="{{ item.icon }}" aria-hidden="true"></i><span>{{ item.handle }}</span></a>{% endif %}{% endfor %}
          </nav>
        </div>
      </div>
      <div class="footer-row footer-bottom"><small>© {{ footer.copyright.year }} {{ footer.copyright.holder }}</small><small>Todos os direitos reservados.</small></div>
    </div>
  </div>
</footer>

