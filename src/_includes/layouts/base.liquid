<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {% assign pageMeta = meta[page.url] %}
  {% assign pageTitle = pageMeta.title | default: title %}
  {% assign pageDescription = description | default: pageMeta.description | default: clinic.description %}

  <title>{% if pageTitle %}{{ pageTitle }} · {{ clinic.name }}{% else %}{{ clinic.name }}{% endif %}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ clinic.url }}{{ page.url }}">
  <link rel="icon" type="image/png" href="{{ '/assets/images/logo-square.png' | url }}">
  <link rel="apple-touch-icon" href="{{ '/assets/images/logo-square.png' | url }}">

  <!-- Open Graph -->
  <meta property="og:locale" content="pt_BR">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{% if pageTitle %}{{ pageTitle }} · {{ clinic.name }}{% else %}{{ clinic.name }}{% endif %}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ clinic.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ clinic.name }}">
  <meta property="og:image" content="{{ clinic.url }}{{ pageMeta.image | default: '/assets/images/schema/fachada.jpg' }}">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": {{ schema.type | jsonify }},
    "name": {{ clinic.name | jsonify }},
    "description": {{ clinic.description | jsonify }},
    "url": {{ clinic.url | jsonify }},
    "telephone": {{ clinic.contact.phone | jsonify }},
    "email": {{ clinic.contact.email | jsonify }},
    "priceRange": {{ schema.priceRange | jsonify }},
    "address": {
      "@type": "PostalAddress",
      "streetAddress": {{ clinic.location.address | jsonify }},
      "addressLocality": "Belo Horizonte",
      "addressRegion": "MG",
      "addressCountry": "BR"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": {{ schema.geo.latitude }},
      "longitude": {{ schema.geo.longitude }}
    },
    "openingHoursSpecification": [
      {% for spec in schema.openingHours %}
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": {{ spec.days | jsonify }},
        "opens": {{ spec.opens | jsonify }},
        "closes": {{ spec.closes | jsonify }}
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ],
    "sameAs": [
      {{ clinic.social.instagram.url | jsonify }}
    ]
  }
  </script>

  <script src="{{ '/assets/main.js' | url }}" defer></script>
  {% if development %}
    <link rel="stylesheet" href="{{ '/assets/css/base.css' | url }}">
    <link rel="stylesheet" href="{{ '/assets/css/components.css' | url }}">
    <link rel="stylesheet" href="{{ '/assets/css/header.css' | url }}">
    <link rel="stylesheet" href="{{ '/assets/css/footer.css' | url }}">
  {% else %}
    <link rel="stylesheet" href="{{ '/assets/css/global.css' | url }}">
  {% endif %}
  {% if stylesheet %}<link rel="stylesheet" href="{{ '/assets' | url }}{{ stylesheet }}">{% endif %}


  <!-- Google Fonts -->
  <link rel="preconnect" href="{{ 'https://fonts.googleapis.com' | url }}">
  <link rel="preconnect" href="{{ 'https://fonts.gstatic.com' | url }}" crossorigin>
  <link href="{{ 'https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap' | url }}" rel="stylesheet">
</head>
<body class="page-{{ pagename }}">

  {% include "header.liquid" %}

  <main>
    <div class="main-container">
      {{ content }}
    </div>
  </main>

  {% include "footer.liquid" %}
  <link rel="stylesheet" href="{{ 'https://cdn.jsdelivr.net/gh/iconoir-icons/iconoir@main/css/iconoir.css' | url }}" />
</body>
</html>
