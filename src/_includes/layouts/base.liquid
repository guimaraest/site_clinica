<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{% if title %}{{ title }} · {{ clinic.name }}{% else %}{{ clinic.name }}{% endif %}</title>
  <meta name="description" content="{{ description | default: clinic.description }}">

  <script src="{{ '/assets/main.js' | url }}" defer></script>
  <link rel="stylesheet" href="{{ '/assets/css/global.css' | url }}">
  {% if stylesheet %}<link rel="stylesheet" href="{{ '/assets' | url }}{{ stylesheet }}">{% endif %}


  <!-- Google Fonts -->
  <link rel="preconnect" href="{{ 'https://fonts.googleapis.com' | url }}">
  <link rel="preconnect" href="{{ 'https://fonts.gstatic.com' | url }}" crossorigin>
  <link href="{{ 'https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap' | url }}" rel="stylesheet">
</head>
<body class="page-{{ pagename }}">

  {% include "header.liquid" %}

  <main>
    <div class="main-container">
      {{ content }}
    </div>
  </main>

  {% include "footer.liquid" %}
  <link rel="stylesheet" href="{{ 'https://cdn.jsdelivr.net/gh/iconoir-icons/iconoir@main/css/iconoir.css' | url }}" />
</body>
</html>
