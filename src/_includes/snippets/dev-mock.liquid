<style>
    .mock-ide {
        width: 430px;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;

        margin-left: auto;
    }
    
    .mock-file {
        background-color: hsl(0, 0%, 5%);
        width: 100%;
        height: 100%;
        min-height: unset;

        display: flex;
        flex-direction: column;

        padding: 0;
    }

    .mock-nav {
        width: 100%;
        height: 35px;
        
        background-color: hsl(0, 0%, 7%);
        display: flex;
        justify-content: start;
        align-items: center;
        border-radius: 0;

        padding: 8px 20px;
        gap: 8px;

        font-size: 10px;
        font-weight: 300;
        color: var(--text-muted);

        filter: blur(0.2px);
    }
    
    .mock-tab {
        width: 30px;
        height: 5px;
        border-radius: 5px;
        box-shadow: var(--shadow-small);
        background-color: hsl(0, 0%, 15%);
    }

    .mock-code {
        width: 100%;
        height: 100%;
        padding: 10px 20px 20px 20px;
        
        display: flex;
        flex-direction: column;
        white-space: pre;
        font-family: monospace;
        font-size: 10px;
        font-weight: 300;
        color: var(--text-muted);
        
        opacity: 0.9; 
        filter: blur(0.3px);
    }

    .token-keyword           { color: #b18bbd; }            /* Liquid keywords */
    .token-variable          { color: #7faacb; }            /* product, collection */
    .token-string            { color: #c18a6a; }            /* strings */
    .token-tag               { color: #6f95b8; }            /* HTML tags */
    .token-attr              { color: #b8b48a; }            /* attributes */
    .token-css               { color: #6fae9f; }            /* CSS props */
    .token-number            { color: #9fb49a; }            /* numbers */
    .token-comment           { color: #6f8f6f; }            /* comments */
    .token-line-number       { color: hsl(0 0% 45%); }      /* line number */
    .token-muted             { color: var(--text-muted); }
    

@media (max-width: 768px) {

  /* container + frame */
  .mock-ide {
    width: 220px;
    height: 220px;
    margin: 0 auto;
    display: block;
  }

  .mock-file {
    width: 100%;
    height: 100%;
    overflow: hidden;
    box-sizing: border-box;
  }

  .mock-nav {
    height: 32px;
    padding: 6px 12px;
    font-size: 10px;
    color: var(--text-muted);
    filter: blur(0);
  }

  /* CODE: keep a small readable font-size so spans retain width,
     but compress vertical rhythm so rectangles are 4px tall */
  .mock-code {
    padding: 12px 12px;
    height: calc(100% - 32px);
    overflow: hidden;
    white-space: pre;
    gap: 2px;
    font-family: monospace;
    font-size: 4px;      /* small, not zero — controls inline width */
    line-height: 4px;    /* forces row height to the rectangles' height */
    color: transparent;
    filter: blur(0);
    opacity: 0.6;   /* make any text invisible but still measure it */
  }

  /* each line becomes a single horizontal row */
  .mock-code-line {
    min-height: 4px;
    height: 4px;
    overflow: hidden;
  }

  /* hide line numbers so they don't produce extra width 
  .mock-code-line .token-line-number {
    display: none;
  }


  /* token spans: become inline-block rectangles; size comes from text width,
     but we add modest horizontal padding and cap width so they aren't very long */
  .mock-code-line span {
    display: inline-block;
    height: 4px;            /* required height */
    line-height: 4px;       /* align if any inline metrics persist */
    padding: 0;         /* small extra width so bars look intentional */
    vertical-align: middle;     /* no radius */
    overflow: hidden;       /* crop very long tokens */
    white-space: nowrap;
    color: transparent;     /* ensure text is invisible */
    background-clip: padding-box;
    box-sizing: border-box;
    max-width: 120px;       /* cap width so rectangles stay short on mobile */
  }

  /* map token colors to rectangle fills */
  .mock-code-line .token-keyword        { background-color: #b18bbd; }
  .mock-code-line .token-variable       { background-color: #7faacb; }
  .mock-code-line .token-string         { background-color: #c18a6a; }
  .mock-code-line .token-tag            { background-color: #6f95b8; }
  .mock-code-line .token-attr           { background-color: #b8b48a; }
  .mock-code-line .token-css            { background-color: #6fae9f; }
  .mock-code-line .token-number         { background-color: #9fb49a; }
  .mock-code-line .token-comment        { background-color: #6f8f6f; }
  .mock-code-line .token-line-number    { background-color: hsl(0 0% 45%); }
  .mock-code-line .token-muted          { background-color: hsl(0 0% 25%); }
  
  .mock-code-line .token-line-number  {
    width: 4px;
  }
  /* safety: prevent any element inside from overflowing the mock */
  .mock-file,
  .mock-code,
  .mock-code-line,
  .mock-code-line span {
    max-width: 100%;
    box-sizing: border-box;
  }
}


</style>

