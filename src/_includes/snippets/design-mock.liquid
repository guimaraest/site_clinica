<style>
    .mock-container {
        position: relative;
        width: 430px;
        height: 100%;

        margin-left: auto;
    }
    
    .mock-page {
        position: absolute;
        width: 400px;
        height: calc(100% - 30px);
        min-height: unset;

        display: flex;
        flex-direction: column;

        padding: 0;
    }

    .mock-container > :nth-child(1) {
        right: 0;
        bottom: 30px;
    }

    .mock-container > :nth-child(2) {
        right: 15px;
        bottom: 15px;
    }

    .mock-container > :nth-child(3) {
        right: 30px;
        bottom: 0;
    }

    .mock-header {
        width: 100%;
        height: 35px;
        background-color: var(--bg-light);
        
        display: flex;
        justify-content: start;
        align-items: center;
        box-shadow: var(--shadow-small);
        border-radius: var(--radius-big) var(--radius-big) 0 0;

        padding: 8px 20px;
        gap: 8px;
    }
    
    .mock-url {
        width: 30px;
        height: 5px;
        border-radius: 5px;
        box-shadow: var(--shadow-small);
        background-color: var(--text-muted);
    }

    .mock-page.top {
        background-color: var(--bg-light);
    }

    .mock-header.top {
        background-color: hsl(0, 0%, 15%);
    }

    .mock-url {
        background-color: hsl(0, 0%, 25%);
    }

    .mock-content {
        width: 100%;
        height: calc(100% - 30px);
        padding: 0 20px 20px 20px;
        
        display: flex;
        flex-direction: column;
    }

    .mock-hero {
        height: 200px;
        margin-top: 20px;

        display: flex;
        justify-content: space-between;
        align-items: start;

        gap: 16px;
    }

    .mock-section {
        height: 160px;
        margin-top: 20px;

        display: flex;
        justify-content: space-between;
        align-items: start;

        gap: 16px;
    }

    .mock-product-image {
        background-color: hsl(0, 0%, 15%);
        border-radius: 8px;
        box-shadow: var(--shadow-small);

        width: 80px;
        height: auto;
        aspect-ratio: 1/1;
    }

    .mock-pdp {
        justify-content: start;
        gap: 8px;
    }

    .mock-text,
    .mock-price,
    .mock-reviews,
    .mock-atc,
    .mock-cta,
    .mock-option,
    .mock-options-wrapper {
        background-color: hsl(0,0%,15%);
        border-radius: 8px;
        box-shadow: var(--shadow-small);
    }

    .mock-text {
        height: 8px;
        width: 80%;
    }

    .mock-price {
        height: 8px;
        width: 30%;
        margin-bottom: 8px;
    }

    .mock-atc {
        background-color: hsl(0,0%,20%);
        height: 20px;
        width: 60%;

        display: flex;
        justify-content: center;
        align-items: center;
    }

    .mock-cta {
        background-color: hsl(0,0%,25%);
        height: 5px;
        width: 50px;
    }



@media (max-width: 768px) {

  /* --- DESIGN MOCK: visual-only mobile treatment --- */

  .mock-container {
    width: 220px;          /* smaller, controlled size */
    height: 220px;
    margin: 0 auto;        /* center it */
  }

  .mock-page {
    width: 200px;
    height: 200px;
  }

  /* hide all fake content */
  .mock-content,
  .mock-hero,
  .mock-section,
  .mock-product-image,
  .mock-pdp,
  .mock-text,
  .mock-price,
  .mock-atc,
  .mock-cta {
    display: none;
  }

  /* keep headers only */
  .mock-header {
    height: 32px;
    padding: 6px 12px;
    border-radius: var(--radius-small) var(--radius-small) 0 0;
  }

  .mock-url {
    width: 22px;
    height: 4px;
    border-radius: 4px;
  }

  /* tighten stacking offsets */
  .mock-container > :nth-child(1) {
    right: 0;
    bottom: 16px;
  }

  .mock-container > :nth-child(2) {
    right: 8px;
    bottom: 8px;
  }

  .mock-container > :nth-child(3) {
    right: 16px;
    bottom: 0;
  }

}



    
</style>

<div class="mock-container">
    <div class="card mock-page">
        <header class="mock-header">
        </header>
    </div>
    <div class="card mock-page">
        <header class="mock-header">
        </header>
    </div>
    <div class="card mock-page top">
        <header class="mock-header top">
            <div class="mock-url"></div>
            <div class="mock-url"></div>
            <div class="mock-url"></div>
        </header>
        <div class="mock-content">
            <div class="mock-hero">
                <div class="column mock-product-image"></div>
                <div class="column mock-pdp">
                    <div class="mock-text"></div> <!-- product title -->
                    <div class="mock-price"></div> <!-- price -->
                    <div class="mock-atc"><div class="mock-cta"></div></div> <!-- atc -->
                </div>
            </div>
            <div class="mock-section">
                <div class="column mock-pdp">
                    <div class="mock-text"></div> <!-- product title -->
                    <div class="mock-text"></div> <!-- product title -->
                    <div class="mock-price"></div> <!-- price -->
                </div>
                <div class="column mock-product-image" style="height: 100%"></div>
            </div>
        </div>
    </div>
</div>