---
pagename: equipe
layout: layouts/base.liquid
title: Equipe | Clínica Odontológica
stylesheet: /css/page/equipe.css
---

<section class="section hero-section hero-gradient" id="hero">
	<div class="section-container">
		<div class="section-content">
			<div class="column">
				<div class="hero-text">
					<h1>Quem cuida do seu sorriso</h1>
					<p class="subheading">Profissionais experientes e sempre atualizados.</p>
				</div>
			</div>
		</div>
	</div>
</section>

<section class="section integration-section" id="lista-equipe">
  <div class="section-container">
    <div class="section-content">
      <div class="column integration-column">
        <h2 class="center">Nossos profissionais</h2>
        <div class="card-grid">
          {% for profissional in equipe %}
          <a href="{{ profissional.slug | prepend: '/equipe/' | append: '/' | url }}" class="center card card-hover img-card-grid">
            <div class="img-card-grid-image"><img src="{{ profissional.image | url }}" alt="{{ profissional.alt }}"></div>
            <div class="img-card-grid-details">
              <div class="img-card-grid-title">{{ profissional.name }}</div>
              <div class="img-card-grid-description">{{ profissional.specialization }}</div>
              <div class="img-card-grid-description">{{ profissional.experience }}</div>
            </div>
          </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>