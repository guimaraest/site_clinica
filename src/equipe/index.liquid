---
pagename: equipe
layout: layouts/base.liquid
title: Equipe | Clínica Odontológica
stylesheet: /css/page/equipe.css
---

<section class="section page-hero" id="hero">
	<div class="section-container">
		<div class="section-content">
			<div class="column">
				<div class="hero-text">
					<h1>Quem cuida do seu sorriso</h1>
					<p class="subheading">Profissionais experientes e sempre atualizados.</p>
				</div>
			</div>
		</div>
	</div>
</section>

<section class="section integration-section" id="lista-equipe">
  <div class="section-container">
    <div class="section-content">
      <div class="column integration-column">
        <h2 class="center">Nossos profissionais</h2>
        <div class="team-list">
          {% for profissional in equipe %}
          <article class="team-entry">
            <a href="{{ profissional.slug | prepend: '/equipe/' | append: '/' | url }}" class="team-card card card-hover img-card-grid">
              <div class="img-card-grid-image">{% image profissional.image, profissional.alt, "(max-width: 700px) 50vw, 25vw" %}</div>
              <div class="team-card-content"><div class="team-card-name">{{ profissional.name }}</div><span class="team-card-role">{{ profissional.specialization }}</span></div>
            </a>
            <div class="team-card-meta"><span>{{ profissional.experience }}</span><a href="{{ profissional.slug | prepend: '/equipe/' | append: '/' | url }}" class="text-link">Ver perfil <i class="iconoir-arrow-right"></i></a></div>
          </article>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
